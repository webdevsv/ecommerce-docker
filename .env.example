# ---------- MySQL (servicio "db") ----------
# Contraseña del usuario root de MySQL (obligatoria)
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
# Base de datos que se crea automáticamente la primera vez
MYSQL_DATABASE=laravel
# Usuario y contraseña que usará Laravel para conectarse
MYSQL_USER=laravel
MYSQL_PASSWORD=cambia_esta_clave


# ---------- Laravel (servicio "backend") ----------
APP_NAME=EcommerceAPI
APP_ENV=production
APP_DEBUG=false
# URL pública de la API (a través de Nginx)
APP_URL=http://localhost:8000
# Clave de cifrado de Laravel (obligatoria). Genérala con:
# docker run --rm --entrypoint php ecommerce-backend:1.0 artisan key:generate --show
APP_KEY=
# true = ejecuta las migraciones al arrancar el contenedor
RUN_MIGRATIONS=true

# Stripe (claves de PRUEBA del dashboard de Stripe)
STRIPE_KEY=pk_test_xxx
STRIPE_SECRET=sk_test_xxx
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd